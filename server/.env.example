# Hatch — local dev runtime values. Copy to server/.env.local (gitignored) for `edgespark dev`.
# For deployed envs use `edgespark var set` / `edgespark secret set` instead (NOT this file).
# Only keys declared in src/defs/runtime.ts (VarKey / SecretKey) are loaded.

# VarKey — the owner's login email; gates the management API / dashboard.
OWNER_EMAIL=owner@example.com

# SecretKey — HMAC signing key for short-lived owner management tokens.
# Generate a strong value, e.g.  openssl rand -base64 32
MGMT_TOKEN_SECRET=dev-only-secret-change-me
